# Database — local PostgreSQL (change password/port to match your PC)
# Default install on Windows often uses port 5432; this PC uses 5433
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5433/nexus_agency?schema=public"

# Neon (cloud) — use when deploying / after local dev is done
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&pgbouncer=true"
# Auth
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Site (REQUIRED for production SEO — use your live domain)
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"
NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/your-account/30min"

# SEO & Analytics (add after deploy)
GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Stripe (Visa / Mastercard payments)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email (Resend — optional but recommended for form notifications)
RESEND_API_KEY=""
RESEND_FROM="Nexus Digital <onboarding@resend.dev>"
ADMIN_EMAIL="admin@nexusdigital.com"

# ─── n8n Agency Automation ───────────────────────────────────────────────────
N8N_ENABLED="true"
N8N_BASE_URL="http://localhost:5678"
N8N_WEBHOOK_SECRET="your-shared-n8n-secret-change-in-production"
N8N_ENCRYPTION_KEY="change-me-n8n-encryption-key"
# Master webhook path (create Webhook node in n8n with this path)
N8N_WEBHOOK_MASTER="/webhook/agency-automation"
# Optional per-category webhooks (leave empty to use master router)
# N8N_WEBHOOK_LEAD=/webhook/lead-management
# N8N_WEBHOOK_ONBOARDING=/webhook/client-onboarding
# N8N_WEBHOOK_SALES=/webhook/sales
# N8N_WEBHOOK_PROJECT=/webhook/project-management
# N8N_WEBHOOK_SUPPORT=/webhook/support
# N8N_WEBHOOK_FINANCE=/webhook/finance
# N8N_WEBHOOK_HR=/webhook/hr
# N8N_WEBHOOK_MARKETING=/webhook/marketing
# N8N_WEBHOOK_AI=/webhook/ai-automation
# N8N_WEBHOOK_LEAD_GEN=/webhook/lead-generation
# Cron secret for /api/cron/automation (n8n Schedule Trigger can call this)
CRON_SECRET="your-cron-secret-change-in-production"




# Admin login
# URL: http://localhost:3000/admin/login
# Email: admin@nexusdigital.com
# Password: admin123
